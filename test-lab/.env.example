# Acrynite Test Lab configuration.
#
# lab.sh copies this file to .env on the first `./lab.sh up`, replaces the three
# passwords below with freshly generated random values, then appends:
#   LAB_WORK = <absolute path to test-lab/work>
#
# You may edit .env by hand afterwards (for example to move a published port).

# --- Database passwords (lab.sh randomizes these on first run) ---
POSTGRES_PASSWORD=change-me-on-first-run
ACRYNITE_BACKUP_PASSWORD=change-me-on-first-run
LAB_WRITER_PASSWORD=change-me-on-first-run

# --- S3 (LocalStack) ---
# LocalStack is a faithful, anonymously pullable S3 emulator. MinIO's images now require
# a Docker Hub / quay login, which would break the "no account needed" promise.
# Override S3_IMAGE to use any other backend you can pull.
S3_IMAGE=localstack/localstack:4
S3_BUCKET=acrynite-lab
# LocalStack ignores the credential values but the AWS SDK requires them to be set.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# --- Behaviour ---
WRITE_INTERVAL=3
ACRYNITE_VERSION=latest
# Optional: point at a locally built Linux binary under work/ to test unreleased code, e.g.
#   GOOS=linux GOARCH=amd64 go build -o test-lab/work/bin/acrynite .
#   ACRYNITE_BINARY=${LAB_WORK}/bin/acrynite
ACRYNITE_BINARY=

# --- Published host ports (always bound to 127.0.0.1) ---
PG_HOST_PORT=55432
S3_HOST_PORT=4566
RECOVERY_PORT=55433

# --- Lab-only shortcut ---
# If set, lab.sh runs ALTER SYSTEM SET archive_timeout after `wal enable`, so an idle
# database produces a WAL segment in seconds instead of the 5min default. Lab-only.
ARCHIVE_TIMEOUT_LAB=30s
